{
  "name": "leaf-dot-is",
  "version": "0.0.0",
  "description": "The personal website of Leaf Rogers",
  "main": "server/init.js",
  "scripts": {
    "build": "esbuild client/init.js --minify --bundle --outfile=public/js/init.js",
    "build:watch": "npm run -s build -- --watch",
    "lint": "npm run -s lint:syntax-and-formatting && npm run -s lint:types",
    "lint:syntax-and-formatting": "biome ci && echo \"✓ Linted syntax and styling\"",
    "lint:types": "tsc -p jsconfig.json && echo \"✓ Linted types\"",
    "start": "node server/init.js",
    "start:dev": "doppler run -c development -p leaf-dot-is -- npm run start:watch",
    "start:watch": "npm start -- --watch",
    "test": "npm run -s lint && npm run -s test:coverage",
    "test:coverage": "npm run -s vitest -- run --coverage",
    "test:watch": "npm run -s vitest -- --watch",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:test:integrations": "bash scripts/test-db-integrations.sh",
    "vitest": "TZ=UTC BASE_URL='' PERMALINK_BASE_URL='' PRISMIC_ACCESS_TOKEN='' PRISMIC_REPO_NAME='test' PRISMIC_TYPES_TOKEN='' PG_CONNECTION_STRING='' vitest"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafrogers/leaf-dot-is.git"
  },
  "license": "MIT",
  "dependencies": {
    "@prismicio/client": "^7.23.1",
    "@prismicio/helpers": "^2.3.9",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "express": "^4.22.3",
    "feed": "^4.2.2",
    "helmet": "^8.3.0",
    "node-html-parser": "^7.1.0",
    "postgres-pool": "^10.1.34",
    "prettier": "^3.10.1",
    "serve-favicon": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jsdom": "^30.0.0",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prismic-ts-codegen": "^0.1.31",
    "supabase": "2.117.0",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24.10.x"
  }
}
